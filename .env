# URL base compartida por todos los endpoints
BASE_URL=https://test-k8s.artprovincia.ar

# Intervalo de monitoreo en milisegundos (30000 = 30 segundos)
POLL_INTERVAL_MS=30000
PORT=3000
REQUEST_TIMEOUT_MS=15000

# Configuración de endpoints en formato JSON.
# Cada elemento admite: id, description, method, path, headers, body, expectedStatus.
# Se pueden usar variables de entorno en headers/body con ${NOMBRE_VARIABLE}.
# No guardes secretos reales en este archivo si lo vas a compartir o versionar.
ENDPOINTS_JSON='[
  {
    "id": "cargo",
    "description": "Consulta los cargos disponibles",
    "method": "GET",
    "path": "/core/organization/v1/parametros/cargo",
    "headers": {
      "Accept": "application/json"
    },
    "expectedStatus": [200]
  },
  {
    "id": "area",
    "description": "Consulta las áreas disponibles",
    "method": "GET",
    "path": "/core/organization/v1/parametros/area",
    "headers": {
      "Accept": "application/json"
    },
    "expectedStatus": [200]
  },
  {
    "id": "usuarios-admin",
    "description": "Consulta usuarios - Usuario logueado ADMIN ART",
    "method": "GET",
    "path": "/atencion-al-cliente/administracion-usuario/v2/usuarios?idUsuario=572817",
    "headers": {
      "Accept": "application/json",
      "consumidor": "CLIENTES"
    },
    "auth": {
      "loginUrl": "https://test-k8s.artprovincia.ar/atencion-al-cliente/clientes/v1/login",
      "loginBody": {
        "idUsuario": 572817,
        "contrato": 8064,
        "email": "ffaiella@provart.com.ar",
        "cuit": "23121231239"
      }
    },
    "expectedStatus": [200]
  }
]'

# Opcionales: completar si el primer endpoint necesita autenticación.
# API_TOKEN=tu_token
# CONSUMIDOR=tu_consumidor
